# Copie para .env e preencha localmente. Nunca commitar .env real.

APP_ENV=development

# Telegram MTProto (sessão de leitura) — passo manual, ver docs/OPERATIONS.md
TG_API_ID=
TG_API_HASH=

# Bot notifier (BotFather) — passo manual, ver docs/OPERATIONS.md
BOT_TOKEN=

# Fuso (IANA) usado para fechar o "dia" do histórico de preços. Os horários
# continuam gravados em UTC. Padrão: America/Sao_Paulo.
# DISPLAY_TIMEZONE=America/Sao_Paulo

# Modo demonstração (S19-03): o painel real sobre dados 100% fictícios, sem Telegram,
# sem bot e sem segredos. Não use num deploy real — o app recusa um banco com dados
# reais quando TELEYES_DEMO=1 (e um banco de demonstração quando está desligado).
# O caminho suportado é `docker compose -f docker-compose.demo.yml up --build`.
# TELEYES_DEMO=1
# TELEYES_DEMO_READONLY=1   # recusa toda escrita (403 em pt-BR); 0 libera para brincar
# TELEYES_DEMO_LIVE=1       # insere uma oferta fictícia a cada ~20-40 s no feed ao vivo

# Monitoramento externo opcional. A URL costuma conter um identificador
# sensível: guarde apenas no .env local e nunca compartilhe/logue seu valor.
# Vazio desliga completamente o heartbeat. Intervalo padrão: 300 segundos.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=300
