# teleyes configuration. install.sh copies this file to `.env` (never overwriting an
# existing one) and fills in the values it can; edit `.env` by hand for the rest.
# `.env` is git-ignored: never commit it, paste it in an issue or share a screenshot of it.
# After editing, apply with:  docker compose up -d

# --- Stack (written by install.sh) -----------------------------------------------------

# Host port of the dashboard. Published on 127.0.0.1 only. Optional, default 8080.
# install.sh --port N sets it.
TELEYES_PORT=8080

# Your timezone (IANA name, e.g. America/New_York, Europe/Lisbon, America/Sao_Paulo).
# Used for containers' clocks and to close the "day" of the price history; timestamps
# are always stored in UTC. Optional, install.sh detects it. Find yours:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DISPLAY_TIMEZONE=UTC

# Whether the login cookie requires HTTPS (default true). install.sh sets `false` for plain-http
# http://127.0.0.1 install (Safari drops Secure cookies on http). Leave it `true` when you
# put HTTPS in front (Tailscale Serve, a reverse proxy). Optional, default true.
# SESSION_COOKIE_SECURE=true

# Free-form label shown on the health page. Optional.
APP_ENV=production

# --- Telegram (NOT asked by install.sh; the app runs "not_configured" without them) ----
# You do not have to fill these in: the setup wizard in the dashboard collects the same values
# and stores them privately (see docs/SECURITY_SETUP.md). Values set here win over the wizard's.

# Telegram API credentials for the reading session (MTProto). Required for the monitor
# to read groups. Create an app at https://my.telegram.org/apps -> "API development
# tools"; copy "App api_id" and "App api_hash". A dedicated Telegram account is
# recommended: the session is equivalent to a full login to that account.
TG_API_ID=
TG_API_HASH=

# Token of YOUR OWN bot, used to send you alerts. Required for alerts. Talk to
# @BotFather on Telegram, send /newbot, copy the token. Then open your bot and send
# /start so it can message you.
BOT_TOKEN=

# --- Optional ----------------------------------------------------------------------------

# External uptime monitor ping (e.g. a healthchecks.io URL). The URL usually contains a
# private id: keep it only here. Empty disables the heartbeat. Interval in seconds.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=300

# Backups: every BACKUP_INTERVAL_SECONDS (default 21600 = 6 h), keep the newest
# BACKUP_RETENTION_COUNT copies (default 28).
# BACKUP_INTERVAL_SECONDS=21600
# BACKUP_RETENTION_COUNT=28

# Demo mode (fictional data, no Telegram). Do not set it on a real install: use
# `./install.sh --demo`, which runs a separate, throw-away stack.
# TELEYES_DEMO=1
# TELEYES_DEMO_READONLY=1
# TELEYES_DEMO_LIVE=1
